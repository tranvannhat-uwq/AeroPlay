<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the full square artwork inside Android 12+'s circular safe area.
     A 288dp canvas / 192dp safe circle fits a square <=135dp; 28% inset yields 127dp. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="28%">
    <bitmap android:src="@drawable/brand_app_icon" android:gravity="fill" android:filter="true" />
</inset>
