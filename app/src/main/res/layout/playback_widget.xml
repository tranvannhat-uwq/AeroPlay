<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_outline">
    <include layout="@layout/widget_glass_layers" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:id="@+id/widget_heading"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:id="@+id/widget_logo"
                android:src="@mipmap/ic_launcher" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/widget_brand"
                android:textSize="12sp"
                android:includeFontPadding="false"
                android:textColor="@color/widget_ink"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginStart="5dp"
                android:text="@string/app_name"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <FrameLayout
                android:id="@+id/widget_art_frame"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/widget_art_frame"
                android:clipToOutline="true"
                android:padding="1dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/widget_art"
                    android:src="@drawable/widget_art_placeholder"
                    android:scaleType="centerCrop"
                    android:background="@drawable/widget_art_frame"
                    android:clipToOutline="true" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_marginStart="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/widget_track"
                    android:textSize="16sp"
                    android:includeFontPadding="false"
                    android:textColor="@color/widget_ink"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/playback_widget_idle" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/widget_artist"
                    android:textSize="12sp"
                    android:includeFontPadding="false"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/widget_secondary"
                    android:maxLines="1"
                    android:ellipsize="end" />
                <include layout="@layout/widget_progress_strip" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:id="@+id/widget_times">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/widget_elapsed"
                        android:textSize="11sp"
                        android:includeFontPadding="false"
                        android:textColor="@color/widget_secondary"
                        android:maxLines="1"
                        android:ellipsize="end" />
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/widget_duration"
                        android:textSize="11sp"
                        android:includeFontPadding="false"
                        android:textColor="@color/widget_secondary"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="2dp">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:id="@+id/widget_previous"
                android:src="@drawable/ic_widget_previous"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:tint="@color/widget_ink"
                android:background="@drawable/widget_icon_touch"
                android:contentDescription="@string/playback_widget_previous"
                android:layout_marginHorizontal="7dp" />
            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:id="@+id/widget_toggle"
                android:src="@drawable/ic_widget_play"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:tint="@color/widget_ink"
                android:background="@drawable/widget_orb_preview"
                android:contentDescription="@string/playback_widget_play"
                android:layout_marginHorizontal="3dp" />
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:id="@+id/widget_next"
                android:src="@drawable/ic_widget_next"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:tint="@color/widget_ink"
                android:background="@drawable/widget_icon_touch"
                android:contentDescription="@string/playback_widget_next"
                android:layout_marginHorizontal="7dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
